# DigiTransit API key: https://portal-api.digitransit.fi
EXPO_PUBLIC_DIGITRANSIT_API_KEY=
# Google Maps Android SDK key: https://console.cloud.google.com/google/maps-apis/credentials
EXPO_PUBLIC_ANDROID_GOOGLE_MAPS_API_KEY=
# Optional Google Maps iOS SDK key for native dark-style parity on iPhone builds
EXPO_PUBLIC_IOS_GOOGLE_MAPS_API_KEY=
# Mapbox public token for the live web map: https://console.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=
# Optional override. Defaults to the DigiTransit Varely GTFS v1 endpoint.
# EXPO_PUBLIC_DIGITRANSIT_API_URL=https://api.digitransit.fi/routing/v2/varely/gtfs/v1
