{
  "name": "digitransit-v2",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:emulator": "NODE_ENV=development ORG_GRADLE_PROJECT_reactNativeArchitectures=x86_64 expo run:android --no-build-cache",
    "android:device": "NODE_ENV=development ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android -d --no-build-cache",
    "android:device:clean": "adb uninstall com.etsija.DigiTransitv2 || true && NODE_ENV=development ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android -d --no-build-cache",
    "android:build:emulator": "cd android && NODE_ENV=development ./gradlew assembleDebug --no-daemon --console=plain",
    "android:build:device": "cd android && NODE_ENV=development ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "metro:device": "adb reverse tcp:8081 tcp:8081 && expo start --dev-client --host localhost",
    "android:usb": "pnpm android:device:clean && pnpm metro:device",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:ci && pnpm codegen:check",
    "start": "expo start --tunnel",
    "dev": "eas build --platform android --profile development",
    "preview": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.0.1",
    "@react-navigation/bottom-tabs": "^7.7.3",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.28",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~55.0.3",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.9",
    "expo-device": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.7",
    "expo-image": "~55.0.5",
    "expo-linear-gradient": "^55.0.8",
    "expo-linking": "~55.0.7",
    "expo-location": "~55.1.2",
    "expo-router": "~55.0.3",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-web-browser": "~55.0.9",
    "graphql": "^16.13.1",
    "graphql-request": "^7.4.0",
    "mapbox-gl": "^3.19.1",
    "nativewind": "^4.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-css-interop": "^0.2.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.26.20",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.3",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@parcel/watcher": "^2.5.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "pnpm@10.29.3"
}
